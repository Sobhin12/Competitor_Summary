# Copy to Backend/.env for local development. In production these are set
# as environment variables on Render instead (never committed).

# Phase 1: document retrieval
PARALLEL_API_KEY=

# Phase 2: LLM extraction
GEMINI_API_KEY=

# v2 chat / insight narrative LLM. Provider is picked from whichever is
# configured first: Databricks, then Anthropic, then Gemini (above). Force one
# with CHAT_LLM_PROVIDER=databricks|anthropic|gemini; CHAT_LLM_MODEL overrides
# the model for any provider.
# Databricks: workspace URL, a service principal's OAuth client id/secret
# (machine-to-machine), and the Model Serving endpoint name (Serving tab in the
# workspace, e.g. databricks-claude-sonnet-4-5). The principal needs "Can Query"
# on that endpoint.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_MODEL=
ANTHROPIC_API_KEY=
CHAT_LLM_PROVIDER=

# Document storage (S3-compatible storage). Optional locally - if unset, the
# pipeline just reads/writes the local filesystem as before. Required in
# production, since Render's disk doesn't persist across deploys/restarts.
S3_ACCOUNT_ID=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: S3_ENDPOINT_URL (MinIO or custom endpoint), S3_REGION (e.g. ap-south-1 for AWS).
# S3_ACCOUNT_ID is only for Cloudflare R2 (builds its endpoint); omit it for AWS S3.

# Extra CORS origins to allow, comma-separated (the deployed Vercel URL).
# Localhost is always allowed; this is only needed in production.
CORS_ALLOWED_ORIGINS=


# Hours a competitor's fetched news is served from cache (News tab)
NEWS_TTL_HOURS=6
